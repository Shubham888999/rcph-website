rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function presidentAssignmentPath() {
      return /databases/$(database)/documents/bodPositionAssignments/$(("president_" + request.auth.uid));
    }

    function websiteDirectorAssignmentPath() {
      return /databases/$(database)/documents/bodPositionAssignments/$(("cwd_" + request.auth.uid));
    }

    function saaAssignmentPath() {
  return /databases/$(database)/documents/bodPositionAssignments/$(("saa_" + request.auth.uid));
}

    function coSaaAssignmentPath() {
  return /databases/$(database)/documents/bodPositionAssignments/$(("co-saa_" + request.auth.uid));
}

    function hasNoTerminalLifecycleFields(data) {
      return !data.keys().hasAny([
        'revokedAt',
        'disabledAt',
        'inactiveAt',
        'deletedAt',
        'archivedAt',
        'removedAt',
        'endedAt',
        'historicalAt'
      ]);
    }

    function hasNoExpiredLifecycle(data) {
      return !data.keys().hasAny(['expiresAt'])
        || (data.expiresAt is timestamp && request.time < data.expiresAt);
    }

    function isActiveLifecycleRecord(data) {
      return data.get('active', true) != false
        && data.get('disabled', false) != true
        && data.get('deleted', false) != true
        && data.get('archived', false) != true
        && data.get('removed', false) != true
        && data.get('accessRevoked', false) != true
        && hasNoTerminalLifecycleFields(data)
        && hasNoExpiredLifecycle(data);
    }

    function isApprovedActiveRecord(data) {
      return data.get('status', '') == 'approved'
        && isActiveLifecycleRecord(data);
    }

    function hasApprovedActiveRole(role) {
      return signedIn()
        && exists(rolePath())
        && exists(userPath())
        && get(rolePath()).data.role == role
        && get(userPath()).data.role == role
        && isApprovedActiveRecord(get(rolePath()).data)
        && isApprovedActiveRecord(get(userPath()).data);
    }

    function hasAnyRole(roles) {
      return signedIn()
        && exists(rolePath())
        && get(rolePath()).data.role in roles
        && exists(userPath())
        && get(userPath()).data.role == get(rolePath()).data.role
        && isApprovedActiveRecord(get(rolePath()).data)
        && isApprovedActiveRecord(get(userPath()).data);
    }

    function hasActivePositionAssignment(assignmentPath, positionKey) {
      return exists(assignmentPath)
        && get(assignmentPath).data.positionKey == positionKey
        && get(assignmentPath).data.uid == request.auth.uid
        && get(assignmentPath).data.active == true
        && get(assignmentPath).data.get('status', 'active') in ['active', 'approved']
        && isActiveLifecycleRecord(get(assignmentPath).data);
    }

    function hasActivePresidentAssignment() {
      return hasAnyRole(['bod', 'admin', 'president'])
        && get(userPath()).data.get('positionKeys', []).hasAny(['president'])
        && hasActivePositionAssignment(presidentAssignmentPath(), 'president');
    }

function hasActiveSaaAssignment() {
  return hasAnyRole(['bod', 'admin', 'president'])
    && hasActivePositionAssignment(
      saaAssignmentPath(),
      'saa'
    );
}

function hasActiveCoSaaAssignment() {
  return hasAnyRole(['bod', 'admin', 'president'])
    && hasActivePositionAssignment(
      coSaaAssignmentPath(),
      'co-saa'
    );
}

function hasActiveSergeantAtArmsAssignment() {
  return hasActiveSaaAssignment() || hasActiveCoSaaAssignment();
}

    function hasWebsiteDirectorPosition() {
      return hasAnyRole(['bod', 'admin', 'president'])
        && get(userPath()).data.get('positionKeys', []).hasAny(['cwd'])
        && hasActivePositionAssignment(websiteDirectorAssignmentPath(), 'cwd');
    }

    function hasPresidentAuthority() {
      return hasActivePresidentAssignment() || hasWebsiteDirectorPosition();
    }

function isAdmin() {
  return hasApprovedActiveRole('admin')
    || hasApprovedActiveRole('president')
    || hasPresidentAuthority();
}

function hasAdminPanelAuthority() {
  return hasApprovedActiveRole('admin')
    || hasApprovedActiveRole('president')
    || hasPresidentAuthority();
}
    function isApprovedBod() {
      return hasApprovedActiveRole('bod') || isAdmin();
    }

    function hasLockTools() {
      return hasApprovedActiveRole('admin')
        || hasApprovedActiveRole('president')
        || hasPresidentAuthority();
    }

function hasSergeantAttendanceCollectionAccess() {
  return hasActiveSergeantAtArmsAssignment();
}

function canReadAttendanceLock(panelId) {
  return panelId in ['attendance', 'bodAttendance']
    && hasSergeantAttendanceCollectionAccess();
}

function isFineLinkedTreasury(data) {
  return data.keys().hasAny([
    'fineId',
    'linkedFineId',
    'treasuryEntryId'
  ])
  || (
    data.keys().hasAny(['source'])
    && data.source == 'fine'
  );
}

    function panelLocked(panelKey) {
      return exists(/databases/$(database)/documents/locks/$(panelKey))
        && get(/databases/$(database)/documents/locks/$(panelKey)).data.locked == true;
    }

    function validBodAvenueCodes() {
      return ['ISD', 'CMD', 'CSD', 'PDD', 'RRRO', 'PRO', 'DEI', 'CWD', 'SPORTS', 'FINANCE', 'GBM'];
    }

    function validBodAvenueDescriptionValue(descriptions, code) {
      return !(code in descriptions)
        || (descriptions[code] is string
          && descriptions[code].size() > 0
          && descriptions[code].size() <= 2500);
    }

    function validBodAvenueDescriptions(data) {
      return data.avenueDescriptions is map
        && data.avenueDescriptions.keys().hasOnly(data.avenues)
        && data.avenueDescriptions.keys().hasAll(data.avenues)
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'ISD')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'CMD')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'CSD')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'PDD')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'RRRO')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'PRO')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'DEI')
        && validBodAvenueDescriptionValue(data.avenueDescriptions, 'GBM');
    }

    function validBodFocusAreaValue(category, value) {
      return (category == 'rotary'
          && [value].hasOnly([
            'Peacebuilding and conflict prevention',
            'Disease prevention and treatment',
            'Water, sanitation, and hygiene',
            'Maternal and child health',
            'Basic education and literacy',
            'Community economic development',
            'Environment',
          ]))
        || (category == 'ascend'
          && [value].hasOnly([
            'Harvesting Innovation',
            'Media',
            'Rescue Operation',
            'Finance',
            'Blue Careers - Future jobs beneath the surface',
            'Product Lab',
            'Hospitality',
            'Renewable Energy',
            'Art and Theatre',
            'A.I Tech',
          ]))
        || (category == 'other' && value != 'Other');
    }

    function validBodFocusAreaEntry(area) {
      return area is map
        && area.keys().hasOnly(['category', 'value'])
        && area.category is string
        && area.value is string
        && area.value.size() > 0
        && area.value.size() <= 180
        && validBodFocusAreaValue(area.category, area.value);
    }

    function validBodFocusAreaAt(areas, index) {
      return areas.size() <= index || validBodFocusAreaEntry(areas[index]);
    }

    function validBodFocusAreas(data) {
      return !data.keys().hasAny(['focusAreas'])
        || (data.focusAreas is list
          && data.focusAreas.size() <= 20
          && validBodFocusAreaAt(data.focusAreas, 0)
          && validBodFocusAreaAt(data.focusAreas, 1)
          && validBodFocusAreaAt(data.focusAreas, 2)
          && validBodFocusAreaAt(data.focusAreas, 3)
          && validBodFocusAreaAt(data.focusAreas, 4)
          && validBodFocusAreaAt(data.focusAreas, 5)
          && validBodFocusAreaAt(data.focusAreas, 6)
          && validBodFocusAreaAt(data.focusAreas, 7)
          && validBodFocusAreaAt(data.focusAreas, 8)
          && validBodFocusAreaAt(data.focusAreas, 9)
          && validBodFocusAreaAt(data.focusAreas, 10)
          && validBodFocusAreaAt(data.focusAreas, 11)
          && validBodFocusAreaAt(data.focusAreas, 12)
          && validBodFocusAreaAt(data.focusAreas, 13)
          && validBodFocusAreaAt(data.focusAreas, 14)
          && validBodFocusAreaAt(data.focusAreas, 15)
          && validBodFocusAreaAt(data.focusAreas, 16)
          && validBodFocusAreaAt(data.focusAreas, 17)
          && validBodFocusAreaAt(data.focusAreas, 18)
          && validBodFocusAreaAt(data.focusAreas, 19));
    }

    function validMemberRid(data) {
      return !data.keys().hasAny(['rid'])
        || (data.rid is string
          && data.rid.size() <= 40
          && data.rid.matches('^[^\\x00-\\x1F\\x7F]*$'));
    }

    function validMemberProfileWrite(data) {
      return validMemberRid(data)
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 160))
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 320))
        && (!data.keys().hasAny(['active']) || data.active is bool);
    }

    function validBodEventWrite(data) {
      return data.type == 'clubEvent'
        && data.description is string
        && data.description.size() <= 2500
        && data.desc == data.description
        && data.avenues is list
        && data.avenue is list
        && data.avenues == data.avenue
        && data.avenues.size() > 0
        && data.avenues.size() <= 11
        && data.avenues.hasOnly(validBodAvenueCodes())
        && validBodAvenueDescriptions(data)
        && validBodFocusAreas(data);
    }

    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /bodPositionOccupancy/{positionKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bodPositionAssignments/{assignmentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rolePositionAudit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /profileChangeAudit/{auditId} {
      allow read, write: if false;
    }

    match /adminMaintenanceAudit/{auditId} {
      allow read, write: if false;
    }

    match /systemLogs/{logId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    match /bodSettings/{document} {
      allow read, write: if false;
    }

    match /bodBoards/{boardId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /bodProfilePhotoUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /bodProfilePhotoUploadRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /visitSubmissionConfig/{visitType} {
      allow read, write: if false;
    }

    match /visitSubmissionPositions/{folderId} {
      allow read, write: if false;
    }

    match /visitSubmissions/{submissionId} {
      allow read, write: if false;
    }

    match /visitSubmissionAudit/{auditId} {
      allow read, write: if false;
    }

    match /visitSubmissionBulkUploads/{bulkUploadId} {
      allow read, write: if false;
    }

    match /visitSubmissionFolderLocks/{folderLockId} {
      allow read, write: if false;
    }

    match /visitSubmissionUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /visitDashboardConfig/{visitType} {
      allow read, write: if false;
    }

    match /visitDashboardAudit/{auditId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && !panelLocked('attendance');
    }

    match /members/{memberId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update: if isAdmin()
        && !panelLocked('attendance')
        && validMemberProfileWrite(request.resource.data);
      allow delete: if isAdmin() && !panelLocked('attendance');
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update, delete: if (isAdmin() || hasSergeantAttendanceCollectionAccess()) && !panelLocked('attendance');
    }

    match /districtEvents/{eventId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update, delete: if isAdmin() && !panelLocked('attendance');
    }

    match /districtAttendance/{attendanceId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update, delete: if (isAdmin() || hasSergeantAttendanceCollectionAccess()) && !panelLocked('attendance');
    }

    match /bodMembers/{memberId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update, delete: if isAdmin() && !panelLocked('bodAttendance');
    }

    match /bodMeetings/{meetingId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update, delete: if isAdmin() && !panelLocked('bodAttendance');
    }

    match /bodAttendance/{attendanceId} {
      allow read: if isAdmin() || hasSergeantAttendanceCollectionAccess();
      allow create, update, delete: if (isAdmin() || hasSergeantAttendanceCollectionAccess()) && !panelLocked('bodAttendance');
    }

    match /bodEvents/{eventId} {
      allow read: if signedIn();
      allow create, update: if isApprovedBod()
        && !panelLocked('bodEvents')
        && validBodEventWrite(request.resource.data);
      allow delete: if isApprovedBod() && !panelLocked('bodEvents');
    }

match /fines/{fineId} {
  allow read: if isAdmin();

  // Fine creation/deletion must go through
  // trusted Functions so Treasury stays linked.
  allow create, update, delete: if false;
}

match /treasury/{transactionId} {
  allow read: if isAdmin();

  // Manual Treasury entries remain client-managed.
  // Fine-linked Treasury entries are backend-only.
  allow create:
    if isAdmin()
    && !panelLocked('treasury')
    && !isFineLinkedTreasury(
      request.resource.data
    );

  allow update:
    if isAdmin()
    && !panelLocked('treasury')
    && !isFineLinkedTreasury(
      resource.data
    )
    && !isFineLinkedTreasury(
      request.resource.data
    );

  allow delete:
    if isAdmin()
    && !panelLocked('treasury')
    && !isFineLinkedTreasury(
      resource.data
    );
}

    match /reminders/{reminderId} {
      allow read, create, update, delete: if hasAdminPanelAuthority();
    }
    match /locks/{panelId} {
      allow read: if canReadAttendanceLock(panelId) || hasAdminPanelAuthority();
      allow create, update, delete: if hasLockTools();
    }

    match /passwordResets/{resetId} {
      allow read, write: if false;
    }

    match /driveUploadTickets/{ticketId} {
      allow read, write: if false;
    }

    match /driveUploadRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /driveUploadGroups/{groupId} {
      allow read, write: if false;
    }

    match /letterheadExchanges/{exchangeId} {
      allow read, write: if false;
    }

    match /letterheadExchangeImageUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /letterheadExchangeImageAccessSessions/{sessionId} {
      allow read, write: if false;
    }

    match /resolutions/{resolutionId} {
      allow read, write: if false;

      match /votes/{voterUid} {
        allow read, write: if false;
      }

      match /audit/{auditId} {
        allow read, write: if false;
      }
    }

    match /resolutionNumberIndex/{indexId} {
      allow read, write: if false;
    }

    match /resolutionDeletionAudit/{auditId} {
      allow read, write: if false;
    }

    match /announcements/{announcementId} {
      allow read, write: if false;
    }

    match /announcementDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /announcementAttachmentUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /resolutionPdfUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /resolutionPdfUploadRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
